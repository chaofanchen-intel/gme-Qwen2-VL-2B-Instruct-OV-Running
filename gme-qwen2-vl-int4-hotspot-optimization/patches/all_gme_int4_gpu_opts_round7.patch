+
+void prepare_primitive_fusing::fuse_normalization_into_dynamic_quantize(program& p) {
+    // A folded node cannot switch back to the f16 pass-through used below the runtime
+    // quantization threshold. Only fold when the caller has disabled that bypass.
+    if (p.get_config().get_dynamic_quantization_threshold() != 0)
+        return;
+    const bool supports_mvn_work_group = p.get_engine().get_device_info().max_work_group_size >= 256;
+
+    auto iterator = p.get_processing_order().begin();
+    while (iterator != p.get_processing_order().end()) {
+        auto node = *iterator++;
+        if (!node->is_type<dynamic_quantize>() || node->is_output())
+            continue;
+
+        auto& dq_node = node->as<dynamic_quantize>();
+        auto dq_primitive = std::const_pointer_cast<dynamic_quantize>(dq_node.get_primitive());
+        if (dq_primitive->fused_rms || dq_primitive->fused_mvn ||
+            dq_node.has_fused_primitives() || dq_node.get_dependencies().size() != 1)
+            continue;
+
+        auto& normalization_node = dq_node.get_dependency(0);
+        if (supports_mvn_work_group && normalization_node.is_type<mvn>()) {
+            auto& mvn_node = normalization_node.as<mvn>();
+            auto mvn_primitive = mvn_node.get_primitive();
+            const auto& fused_ops = mvn_node.get_fused_primitives();
+            if (mvn_node.is_output() || mvn_node.get_users().size() != 1 ||
+                mvn_node.get_dependencies().size() != 3 || fused_ops.size() != 2)
+                continue;
+
+            const auto& product = fused_ops[0];
+            const auto& sum = fused_ops[1];
+            if (!product.is_type<eltwise>() || !sum.is_type<eltwise>() ||
+                product.typed_desc<eltwise>()->mode != eltwise_mode::prod ||
+                sum.typed_desc<eltwise>()->mode != eltwise_mode::sum ||
+                product.inputs.size() != 2 || sum.inputs.size() != 2 ||
+                product.deps.size() != 1 || sum.deps.size() != 1 ||
+                product.outer_dep_start_idx != 1 || sum.outer_dep_start_idx != 2 ||
+                product.inputs[0].m_type != FusedInputType::ORIGINAL || product.inputs[0].m_idx != 0 ||
+                product.inputs[1].m_type != FusedInputType::EXTERNAL || product.inputs[1].m_idx != 1 ||
+                sum.inputs[0].m_type != FusedInputType::INTERNAL || sum.inputs[0].m_idx != 0 ||
+                sum.inputs[1].m_type != FusedInputType::EXTERNAL || sum.inputs[1].m_idx != 2)
+                continue;
+
+            auto& input_node = mvn_node.get_dependency(0);
+            auto& gamma_node = mvn_node.get_dependency(1);
+            auto& beta_node = mvn_node.get_dependency(2);
+            if (product.deps[0].first != gamma_node.id() || sum.deps[0].first != beta_node.id() ||
+                !gamma_node.is_constant() || !beta_node.is_constant())
+                continue;
+
+            const auto input_layout = mvn_node.get_input_layout(0);
+            const auto output_layout = mvn_node.get_output_layout();
+            const auto gamma_layout = gamma_node.get_output_layout();
+            const auto beta_layout = beta_node.get_output_layout();
+            const auto& input_shape = input_layout.get_partial_shape();
+            if (input_layout.data_type != data_types::f16 || output_layout.data_type != data_types::f16 ||
+                dq_node.get_input_layouts()[0].data_type != data_types::f16 ||
+                input_layout.format != format::bfyx || output_layout.format != format::bfyx ||
+                input_layout.data_padding || output_layout.data_padding ||
+                input_shape.rank().is_dynamic() || input_shape.size() != 3 || input_shape[2].is_dynamic() ||
+                input_shape[2].get_length() != 1280 || gamma_layout.is_dynamic() || beta_layout.is_dynamic() ||
+                gamma_layout.count() != 1280 || beta_layout.count() != 1280 ||
+                gamma_layout.data_type != data_types::f16 || beta_layout.data_type != data_types::f16 ||
+                gamma_layout.data_padding || beta_layout.data_padding)
+                continue;
+
+            if (!mvn_primitive->normalize_variance || mvn_primitive->reduction_axes.size() != 1)
+                continue;
+            auto reduction_axis = mvn_primitive->reduction_axes[0];
+            if (reduction_axis < 0)
+                reduction_axis += static_cast<int64_t>(input_shape.size());
+            if (reduction_axis != 2)
+                continue;
+
+            using QuantizationType = ov::op::internal::DynamicQuantize::QuantizationType;
+            const auto& attributes = dq_primitive->attrs;
+            if (attributes.group_sizes.empty())
+                continue;
+            if (attributes.quantization_type != QuantizationType::Symmetric ||
+                attributes.quantization_dt != data_types::i8 || attributes.precomputed_reduction ||
+                attributes.group_sizes.back() != UINT64_MAX ||
+                std::any_of(attributes.group_sizes.begin(), std::prev(attributes.group_sizes.end()),
+                            [](uint64_t group_size) { return group_size != 1; }))
+                continue;
+            bool identity_order = true;
+            for (size_t index = 0; index < attributes.scales_zp_output_order.size(); index++)
+                identity_order &= attributes.scales_zp_output_order[index] == index;
+            if (!identity_order)
+                continue;
+
+            dq_primitive->fused_mvn = true;
+            dq_primitive->mvn_eps = mvn_primitive->epsilon;
+            dq_primitive->mvn_eps_inside_sqrt = mvn_primitive->eps_inside_sqrt;
+            dq_primitive->input = {input_info(input_node.id()), input_info(gamma_node.id()), input_info(beta_node.id())};
+
+            p.remove_connection(mvn_node, dq_node);
+            p.add_connection(input_node, dq_node);
+            p.add_connection(gamma_node, dq_node);
+            p.add_connection(beta_node, dq_node);
+            if (p.remove_if_dangling(mvn_node))
+                p.add_optimized_primitive_info(mvn_primitive->id, {dq_primitive->id});
+            dq_node.recalc_output_layouts(false);
+            continue;
+        }
+
+        auto& rms_node = dq_node.get_dependency(0);
+        if (!rms_node.is_type<rms>() || rms_node.is_output() || rms_node.get_users().size() != 1)
+            continue;
+
+        auto rms_primitive = rms_node.as<rms>().get_primitive();
+        if (!rms_primitive->elementwise_affine || rms_node.get_dependencies().size() != 2)
+            continue;
+
+        if (rms_node.get_input_layouts()[0].data_type != data_types::f16 ||
+            rms_node.get_output_layout().data_type != data_types::f16 ||
+            dq_node.get_input_layouts()[0].data_type != data_types::f16)
+            continue;
+
+        using QuantizationType = ov::op::internal::DynamicQuantize::QuantizationType;
+        const auto& attributes = dq_primitive->attrs;
+        if (attributes.quantization_type != QuantizationType::Symmetric ||
+            attributes.quantization_dt != data_types::i8 ||
+            attributes.precomputed_reduction ||
+            attributes.group_sizes.empty() ||
+            attributes.group_sizes.back() != UINT64_MAX)
+            continue;
+
+        if (std::any_of(attributes.group_sizes.begin(),
+                        std::prev(attributes.group_sizes.end()),
+                        [](uint64_t group_size) { return group_size != 1; }))
+            continue;
+
+        if (!attributes.scales_zp_output_order.empty()) {
+            bool identity_order = true;
+            for (size_t index = 0; index < attributes.scales_zp_output_order.size(); index++)
+                identity_order &= attributes.scales_zp_output_order[index] == index;
+            if (!identity_order)
+                continue;
+        }
+
+        const auto& input_shape = rms_node.get_input_layouts()[0].get_partial_shape();
+        if (input_shape.rank().is_dynamic() || input_shape.size() == 0 ||
+            input_shape[input_shape.size() - 1].is_dynamic())
+            continue;
+
+        const auto row_size = static_cast<size_t>(input_shape[input_shape.size() - 1].get_length());
+        if (row_size != 1536)
+            continue;
+
+        auto& input_node = rms_node.get_dependency(0);
+        auto& gamma_node = rms_node.get_dependency(1);
+        const auto gamma_layout = gamma_node.get_output_layout();
+        if (gamma_layout.is_dynamic() || gamma_layout.count() != row_size ||
+            gamma_layout.data_type != data_types::f16)
+            continue;
+
+        dq_primitive->fused_rms = true;
+        dq_primitive->rms_eps = rms_primitive->epsilon;
+        dq_primitive->input = {input_info(input_node.id()), input_info(gamma_node.id())};
+
+        p.remove_connection(rms_node, dq_node);
+        p.add_connection(input_node, dq_node);
+        p.add_connection(gamma_node, dq_node);
+        if (p.remove_if_dangling(rms_node))
+            p.add_optimized_primitive_info(rms_primitive->id, {dq_primitive->id});
+
+        dq_node.recalc_output_layouts(false);
+    }
 }
 
