+        // Compose with the order the SDPA already emits instead of overwriting it. The node
+        // currently writes P[i] = L[prev[i]] for the logical BHLS result L, and the Transpose then
+        // produces R[i] = P[transpose_order[i]], so the fused order is prev[transpose_order[i]].
+        // prev is the identity unless this SDPA already had an output transpose folded in.
+        auto prev_order_output = fused_sdpa ? fused_sdpa->get_output_transpose_order()
+                                            : op::SDPA::default_order(sdpa->get_output_partial_shape(0).size());
+        std::vector<int64_t> order_output(transpose_order.size());
+        if (transpose_order.size() != prev_order_output.size() ||
+            transpose_order.size() != sdpa->get_output_partial_shape(0).size()) {
+            can_fuse_transposes = false;
+        } else {
+            for (size_t i = 0; i < transpose_order.size(); i++)
