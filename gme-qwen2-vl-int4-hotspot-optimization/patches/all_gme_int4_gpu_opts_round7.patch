+            can_fuse_transposes = false;
+
+        // convert_strides("DST", "OUTPUT", order) in the SDPA generators reads the destination
+        // strides as DST_S[i] = OUTPUT_pitch[order[i]], i.e. it treats the order as mapping the
+        // logical axis to the physical one, whereas shape_infer() applies it the other way round.
+        // The two agree only for self-inverse permutations -- which every real attention block
+        // uses, since it just swaps num_heads and seq_len -- so reject anything else rather than
+        // fold an order the kernels would then read backwards.
+        if (can_fuse_transposes) {
+            for (size_t i = 0; i < order_output.size(); i++) {
+                if (order_output[static_cast<size_t>(order_output[i])] != static_cast<int64_t>(i)) {
+                    can_fuse_transposes = false;
+                    break;
+                }
+            }
+        }
+
+        if (!can_fuse_transposes)
+            return false;
+
+        OutputVector inputs;
+        inputs.push_back(ov::Output<Node>(pattern_map.at(input_q_m).get_node_shared_ptr(), input_q_output_idx));
+        inputs.push_back(ov::Output<Node>(pattern_map.at(input_k_m).get_node_shared_ptr(), input_k_output_idx));
+        inputs.push_back(ov::Output<Node>(pattern_map.at(input_v_m).get_node_shared_ptr(), input_v_output_idx));
+
+        if (pattern_map.find(sdpa_with_attn_mask_m) != pattern_map.end()) {
+            inputs.push_back(sdpa->get_input_source_output(3));
+        } else if (pattern_map.find(sdpa_with_attn_mask_and_scale_m) != pattern_map.end()) {
+            inputs.push_back(sdpa->get_input_source_output(3));
+            inputs.push_back(sdpa->get_input_source_output(4));
+        }
+
+        auto sdpa_new = std::make_shared<op::SDPA>(inputs,
+                                                   sdpa->get_causal(),
+                                                   order_q,
+                                                   order_k,
+                                                   order_v,
+                                                   order_output,
+                                                   fused_sdpa ? fused_sdpa->get_output_type() : ov::element::dynamic);
+
+        sdpa_new->set_friendly_name(m.get_match_root()->get_friendly_name());
+        ov::copy_runtime_info(m.get_matched_nodes(), sdpa_new);
+        ov::replace_node(m.get_match_root(), sdpa_new);
+        return true;
+    };
+
+    auto m = std::make_shared<ov::pass::pattern::Matcher>(transpose_out_m, "TransposeSDPATransposeMatcher");
+    this->register_matcher(m, callback);
+}
