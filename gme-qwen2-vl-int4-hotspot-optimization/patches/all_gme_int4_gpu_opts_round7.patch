 namespace ov::intel_gpu {
 
+namespace {
+bool output_orders_equal(const std::vector<uint64_t>& lhs, const std::vector<uint64_t>& rhs) {
+    if (lhs == rhs)
+        return true;
+
+    const auto is_identity = [](const std::vector<uint64_t>& order) {
+        for (size_t index = 0; index < order.size(); index++) {
+            if (order[index] != index)
+                return false;
+        }
+        return true;
+    };
+    return (lhs.empty() && is_identity(rhs)) || (rhs.empty() && is_identity(lhs));
+}
+
+bool dq_attrs_equal(const ov::op::internal::DynamicQuantize::Attributes& lhs,
+                    const ov::op::internal::DynamicQuantize::Attributes& rhs) {
+    return lhs.quantization_type == rhs.quantization_type &&
+           lhs.quantization_dt == rhs.quantization_dt &&
+           lhs.scale_dt == rhs.scale_dt &&
+           lhs.zp_dt == rhs.zp_dt &&
+           lhs.precomputed_reduction == rhs.precomputed_reduction &&
+           lhs.precomputed_reduction_dt == rhs.precomputed_reduction_dt &&
+           lhs.output_storage_type == rhs.output_storage_type &&
+           output_orders_equal(lhs.scales_zp_output_order, rhs.scales_zp_output_order) &&
+           lhs.group_sizes == rhs.group_sizes;
+}
+
+std::shared_ptr<ov::op::internal::DynamicQuantize> find_reusable_dq(
+    const ov::Output<ov::Node>& activation,
+    const ov::op::internal::DynamicQuantize::Attributes& config) {
+    for (const auto& target_input : activation.get_target_inputs()) {
+        auto candidate = ov::as_type_ptr<ov::op::internal::DynamicQuantize>(
+            target_input.get_node()->shared_from_this());
+        if (candidate && dq_attrs_equal(candidate->get_attrs(), config))
+            return candidate;
+    }
+    return nullptr;
+}
