+    auto sdpa_m = std::make_shared<Or>(OutputVector{sdpa_without_attn_mask_m, sdpa_with_attn_mask_m, sdpa_with_attn_mask_and_scale_m});
+    auto transpose_out_order_m = wrap_type<ov::op::v0::Constant>(consumers_count(1));
+    auto transpose_out_m = wrap_type<ov::op::v1::Transpose>({sdpa_m, transpose_out_order_m}, is_fp_type);
+
+    ov::matcher_pass_callback callback = [OV_CAPTURE_CPY_AND_THIS](Matcher& m) {
+        const auto& pattern_map = m.get_pattern_value_map();
+
+        std::shared_ptr<ov::op::v13::ScaledDotProductAttention> sdpa;
+        for (const auto& sdpa_pattern : {sdpa_without_attn_mask_m, sdpa_with_attn_mask_m, sdpa_with_attn_mask_and_scale_m}) {
+            auto it = pattern_map.find(sdpa_pattern);
+            if (it != pattern_map.end()) {
+                sdpa = ov::as_type_ptr<ov::op::v13::ScaledDotProductAttention>(it->second.get_node_shared_ptr());
+                break;
+            }
+        }
+
+        if (!sdpa || transformation_callback(sdpa)) {
+            return false;
+        }
+
+        // Only the micro SDPA kernel reads output_transpose_order, and it is available on XMX
+        // devices only -- everywhere else SDPAOpt::supports_micro_sdpa() is false and every stage
+        // runs sdpa_opt, which would ignore the folded order.
+        if (!supports_immad) {
+            return false;
+        }
+
+        // SDPAOpt::supports_micro_sdpa() rejects a 3D SDPA outright ("Known limitation: In vision
+        // encoding model of qwen-vl ... restricted to execute with sdpa_opt kernel"), so a headless
+        // attention block -- the Qwen-VL / Qwen3-VL vision tower, whose SDPA is
+        // [num_heads, seq_len, head_size] -- can never honour a folded output order.
+        if (sdpa->get_output_partial_shape(0).size() != 4) {
+            return false;
+        }
+
+        // ov::intel_gpu::op::SDPA derives from ov::op::v13::ScaledDotProductAttention, and
+        // WrapType matches derived types, so the pattern above also matches an SDPA that a
+        // previous matcher already rewrote. This is the normal case: the SDPA node precedes its
+        // output Transpose in topological order, so TransposeSDPAMatcher has already run and has
+        // already absorbed the Q/K/V transposes into order_q/k/v. Those orders must be carried
+        // over -- rebuilding from default_order() while keeping the (already un-transposed)
+        // inputs silently reinterprets Q/K/V with the batch and seq_len axes swapped.
+        auto fused_sdpa = ov::as_type_ptr<op::SDPA>(sdpa);
+
+        // The 6-argument op::SDPA constructor below carries neither the beam table + indirect
+        // axis of IndirectSDPA nor the KV-cache quantization attributes and their scale/zp
+        // inputs, so those two shapes cannot be rebuilt faithfully. They are the stateful
+        // KV-cache paths, where the output Transpose is not on the critical path anyway.
+        if (ov::as_type_ptr<op::IndirectSDPA>(sdpa) || (fused_sdpa && fused_sdpa->get_kv_compressed())) {
+            return false;
+        }
+
+        auto order_q = fused_sdpa ? fused_sdpa->get_input0_transpose_order()
+                                  : op::SDPA::default_order(sdpa->get_input_partial_shape(0).size());
+        auto order_k = fused_sdpa ? fused_sdpa->get_input1_transpose_order()
+                                  : op::SDPA::default_order(sdpa->get_input_partial_shape(1).size());
+        auto order_v = fused_sdpa ? fused_sdpa->get_input2_transpose_order()
+                                  : op::SDPA::default_order(sdpa->get_input_partial_shape(2).size());
+        size_t input_q_output_idx = sdpa->get_input_source_output(0).get_index();
+        size_t input_k_output_idx = sdpa->get_input_source_output(1).get_index();
+        size_t input_v_output_idx = sdpa->get_input_source_output(2).get_index();
+
+        auto process_transpose = [](const std::shared_ptr<Node>& transpose_node,
+                                    const std::shared_ptr<Node>& transpose_order_const_node,
+                                    std::vector<int64_t>& order,
+                                    size_t& output_idx) {
+            auto transpose_order_const = ov::as_type_ptr<ov::op::v0::Constant>(transpose_order_const_node);
+
+            order = transpose_order_const->cast_vector<int64_t>();
+            // Allow any transposes without head_size dim position change
+            if (order.back() != static_cast<int64_t>(order.size() - 1))
+                return false;
+
+            auto transpose = ov::as_type_ptr<ov::op::v1::Transpose>(transpose_node);
+            output_idx = transpose->get_input_source_output(0).get_index();
+
+            return true;
+        };
+
+        bool can_fuse_transposes = true;
+        if (pattern_map.count(transpose_q_m) > 0)
+            can_fuse_transposes &= process_transpose(pattern_map.at(transpose_q_m).get_node_shared_ptr(),
+                                                     pattern_map.at(transpose_q_order_m).get_node_shared_ptr(),
+                                                     order_q, input_q_output_idx);
+
+        if (pattern_map.count(transpose_k_m) > 0)
+            can_fuse_transposes &= process_transpose(pattern_map.at(transpose_k_m).get_node_shared_ptr(),
+                                                     pattern_map.at(transpose_k_order_m).get_node_shared_ptr(),
+                                                     order_k, input_k_output_idx);
+
+        if (pattern_map.count(transpose_v_m) > 0)
+            can_fuse_transposes &= process_transpose(pattern_map.at(transpose_v_m).get_node_shared_ptr(),
+                                                     pattern_map.at(transpose_v_order_m).get_node_shared_ptr(),
+                                                     order_v, input_v_output_idx);
+
+        auto transpose_order =
+            ov::as_type_ptr<ov::op::v0::Constant>(pattern_map.at(transpose_out_order_m).get_node_shared_ptr())->cast_vector<int64_t>();
+        // Compose with the order the SDPA already emits instead of overwriting it. The node
+        // currently writes P[i] = L[prev[i]] for the logical BHLS result L, and the Transpose then
+        // produces R[i] = P[transpose_order[i]], so the fused order is prev[transpose_order[i]].
+        // prev is the identity unless this SDPA already had an output transpose folded in.
+        auto prev_order_output = fused_sdpa ? fused_sdpa->get_output_transpose_order()
+                                            : op::SDPA::default_order(sdpa->get_output_partial_shape(0).size());
+        std::vector<int64_t> order_output(transpose_order.size());
+        if (transpose_order.size() != prev_order_output.size() ||
+            transpose_order.size() != sdpa->get_output_partial_shape(0).size()) {
+            can_fuse_transposes = false;
+        } else {
+            for (size_t i = 0; i < transpose_order.size(); i++)
+                order_output[i] = prev_order_output[transpose_order[i]];
+        }
+
+        // The kernels index the destination by head_size-contiguous rows, so only orders that keep
+        // head_size as the innermost dimension can be folded into the output strides.
+        if (can_fuse_transposes && order_output.back() != static_cast<int64_t>(order_output.size() - 1))
+            can_fuse_transposes = false;
+
+        // convert_strides("DST", "OUTPUT", order) in the SDPA generators reads the destination
+        // strides as DST_S[i] = OUTPUT_pitch[order[i]], i.e. it treats the order as mapping the
+        // logical axis to the physical one, whereas shape_infer() applies it the other way round.
+        // The two agree only for self-inverse permutations -- which every real attention block
+        // uses, since it just swaps num_heads and seq_len -- so reject anything else rather than
+        // fold an order the kernels would then read backwards.
+        if (can_fuse_transposes) {
+            for (size_t i = 0; i < order_output.size(); i++) {
+                if (order_output[static_cast<size_t>(order_output[i])] != static_cast<int64_t>(i)) {
+                    can_fuse_transposes = false;
+                    break;
+                }
+            }
+        }
+
+        if (!can_fuse_transposes)
+            return false;
+
+        OutputVector inputs;
+        inputs.push_back(ov::Output<Node>(pattern_map.at(input_q_m).get_node_shared_ptr(), input_q_output_idx));
+        inputs.push_back(ov::Output<Node>(pattern_map.at(input_k_m).get_node_shared_ptr(), input_k_output_idx));
+        inputs.push_back(ov::Output<Node>(pattern_map.at(input_v_m).get_node_shared_ptr(), input_v_output_idx));
+
+        if (pattern_map.find(sdpa_with_attn_mask_m) != pattern_map.end()) {
+            inputs.push_back(sdpa->get_input_source_output(3));
+        } else if (pattern_map.find(sdpa_with_attn_mask_and_scale_m) != pattern_map.end()) {
+            inputs.push_back(sdpa->get_input_source_output(3));
+            inputs.push_back(sdpa->get_input_source_output(4));
+        }
+
+        auto sdpa_new = std::make_shared<op::SDPA>(inputs,
+                                                   sdpa->get_causal(),
+                                                   order_q,
+                                                   order_k,
+                                                   order_v,
+                                                   order_output,
+                                                   fused_sdpa ? fused_sdpa->get_output_type() : ov::element::dynamic);
+
+        sdpa_new->set_friendly_name(m.get_match_root()->get_friendly_name());
+        ov::copy_runtime_info(m.get_matched_nodes(), sdpa_new);
+        ov::replace_node(m.get_match_root(), sdpa_new);
+        return true;
+    };
+
+    auto m = std::make_shared<ov::pass::pattern::Matcher>(transpose_out_m, "TransposeSDPATransposeMatcher");
+    this->register_matcher(m, callback);
+}
