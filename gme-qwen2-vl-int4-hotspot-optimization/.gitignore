# VTune raw result dirs are machine-specific and hundreds of MB; the summaries and the
# per-computing-task tables are exported into results/vtune_*.txt / results/vtune_tasks_*.tsv.
results/vtune-*/
results/*.sqlite
results/*.data
results/gpu-dump-*/
__pycache__/
pin.log

