             }
+            item.extra_inputs = m_inputs_embedder->get_lm_extra_inputs();
 
             const size_t seq_length = item.inputs_embeds.get_shape().at(1);
             max_seq_length = std::max(max_seq_length, seq_length);
@@ -334,6 +337,59 @@ private:
             }
         }
 
+        std::unordered_map<std::string, ov::Tensor> batched_extra_inputs;
+        for (const auto& [name, source] : batch_items.front().extra_inputs) {
+            if (source.get_size() == 0) {
+                continue;
+            }
+            if (name == "visual_pos_masks") {
+                ov::Tensor batched(ov::element::boolean, {batch_size, max_seq_length});
+                std::fill_n(batched.data<bool>(), batched.get_size(), false);
+                for (size_t batch_idx = 0; batch_idx < batch_size; ++batch_idx) {
+                    const auto it = batch_items[batch_idx].extra_inputs.find(name);
+                    OPENVINO_ASSERT(it != batch_items[batch_idx].extra_inputs.end(),
+                                    "Missing extra input '", name, "' for batch item ", batch_idx);
+                    const ov::Shape source_shape = it->second.get_shape();
+                    OPENVINO_ASSERT(source_shape.size() == 2 && source_shape[0] == 1,
+                                    "Expected Qwen3-VL visual_pos_masks shape [1, sequence], got ", source_shape);
+                    const size_t copy_length = std::min(source_shape[1], max_seq_length);
+                    std::copy_n(it->second.data<const bool>(), copy_length,
+                                batched.data<bool>() + batch_idx * max_seq_length);
+                }
+                batched_extra_inputs.emplace(name, std::move(batched));
+            } else if (name == "deepstack_visual_embeds") {
+                const ov::Shape source_shape = source.get_shape();
+                OPENVINO_ASSERT(source_shape.size() == 3,
+                                "Expected Qwen3-VL deepstack_visual_embeds rank 3, got ", source_shape);
+                const size_t num_layers = source_shape[0];
+                const size_t hidden_size = source_shape[2];
+                size_t total_visual_sequence = 0;
+                for (const auto& item : batch_items) {
+                    const auto it = item.extra_inputs.find(name);
+                    OPENVINO_ASSERT(it != item.extra_inputs.end(),
+                                    "Missing extra input '", name, "' for a batch item");
+                    total_visual_sequence += it->second.get_shape()[1];
+                }
+                ov::Tensor batched(ov::element::f32, {num_layers, total_visual_sequence, hidden_size});
+                size_t visual_offset = 0;
+                for (const auto& item : batch_items) {
+                    const ov::Tensor& item_tensor = item.extra_inputs.at(name);
+                    const size_t item_visual_sequence = item_tensor.get_shape()[1];
+                    for (size_t layer_idx = 0; layer_idx < num_layers; ++layer_idx) {
+                        const float* source_data = item_tensor.data<const float>() + layer_idx * item_visual_sequence * hidden_size;
+                        float* target_data = batched.data<float>() +
+                                             layer_idx * total_visual_sequence * hidden_size +
+                                             visual_offset * hidden_size;
+                        std::copy_n(source_data, item_visual_sequence * hidden_size, target_data);
+                    }
+                    visual_offset += item_visual_sequence;
+                }
+                batched_extra_inputs.emplace(name, std::move(batched));
+            } else {
+                batched_extra_inputs.emplace(name, source);
+            }
+        }
+
         m_language_model_request.reset_state();
         m_language_model_request.set_tensor("inputs_embeds", batched_inputs_embeds);
 
